        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me when a quota resets"
          }
        }
      }
    },
    "iOS tiene las notificaciones desactivadas para PULSO. Actívalas en Ajustes para recibir el aviso.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS tiene las notificaciones desactivadas para PULSO. Actívalas en Ajustes para recibir el aviso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are disabled for PULSO in iOS. Enable them in Settings to receive the alert."
          }
        }
      }
    },
    "El aviso se programa para la hora exacta de renovación que informa el proveedor, así que llega puntual aunque no abras PULSO. Si esa hora cambia, se recoloca en la siguiente lectura.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aviso se programa para la hora exacta de renovación que informa el proveedor, así que llega puntual aunque no abras PULSO. Si esa hora cambia, se recoloca en la siguiente lectura."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alert is scheduled for the exact reset time reported by the provider, so it arrives on time even if you do not open PULSO. If that time changes, it is rescheduled on the next reading."
          }
        }
      }
    },
