    },
    "GitHub no ha devuelto datos de consumo para esta cuenta. No equivale a consumo cero. Comprueba el tipo de cuenta en Conexiones.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no ha devuelto datos de consumo para esta cuenta. No equivale a consumo cero. Comprueba el tipo de cuenta en Conexiones."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub returned no usage data for this account. This does not mean zero usage. Check the account type in Connections."
          }
        }
      }
    },
