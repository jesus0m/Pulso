            "state": "translated",
            "value": "Show sample data"
          }
        }
      }
    },
    "La demostración no reemplaza las lecturas reales ni se comparte con los widgets.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La demostración no reemplaza las lecturas reales ni se comparte con los widgets."
