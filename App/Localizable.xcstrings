            "state": "translated",
            "value": "Claude account email"
          }
        }
      }
    },
    "Continuar con correo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar con correo"
          }
        },
        "en": {
          "stringUnit": {
