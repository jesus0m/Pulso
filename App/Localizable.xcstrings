            "value": "Sign in with your email"
          }
        }
      }
    },
    "Pulso rellena y envía tu correo en la web oficial. Después introduces allí el código que te envíe Claude. No guardamos tu correo en los ajustes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulso rellena y envía tu correo en la web oficial. Después introduces allí el código que te envíe Claude. No guardamos tu correo en los ajustes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulso fills in and submits your email on the official website. Then enter the code Claude sends you there. Your email is not saved in settings."
          }
        }
      }
    },
    "Correo de tu cuenta de Claude": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correo de tu cuenta de Claude"
          }
        },
        "en": {
